<view class="page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 资料卡片 -->
    <view class="profile-card">
      <view class="card-title">好友资料</view>

      <!-- UID -->
      <view class="info-row">
        <text class="info-label">UID</text>
        <view class="uid-row" bindtap="copyUid" wx:if="{{uid}}">
          <text class="info-value uid-value">{{uid}}</text>
          <text class="copy-btn">复制</text>
        </view>
        <text class="info-value" wx:else>未设置</text>
      </view>

      <!-- 注册时间 -->
      <view class="info-row">
        <text class="info-label">注册时间</text>
        <text class="info-value">{{createTime || '未知'}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section" wx:if="{{isFriend}}">
      <view class="action-btn green" bindtap="goToChat">发消息</view>
      <view class="action-btn red" bindtap="deleteFriend">删除好友</view>
    </view>

    <!-- 非好友提示 -->
    <view class="action-section" wx:else>
      <view class="action-btn blue" bindtap="wx.navigateBack">返回</view>
    </view>
  </block>
</view>
