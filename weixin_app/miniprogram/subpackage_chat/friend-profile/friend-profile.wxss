page { background: #f5f5f5; min-height: 100vh; }

/* 加载中 */
.loading-wrap {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding-top: 300rpx;
}
.loading-spinner {
  width: 56rpx; height: 56rpx; border: 4rpx solid #e0e0e0; border-top-color: #07c160;
  border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 28rpx; color: #999; }

/* 资料卡片 */
.profile-card {
  margin: 24rpx; background: #fff; border-radius: 16rpx; overflow: hidden;
}
.card-title {
  padding: 28rpx 32rpx 12rpx; font-size: 26rpx; color: #999; font-weight: 500;
}

/* 信息行 */
.info-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx; border-bottom: 1rpx solid #f5f5f5;
}
.info-row:last-child { border-bottom: none; }
.info-label {
  font-size: 30rpx; color: #333; width: 160rpx; flex-shrink: 0;
}
.info-value {
  font-size: 30rpx; color: #666; flex: 1; text-align: right;
}

/* UID 行特殊样式 */
.uid-row { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; }
.uid-value { color: #07c160 !important; font-weight: 500; }
.copy-btn {
  font-size: 22rpx; color: #07c160; background: rgba(7,193,96,0.08);
  padding: 6rpx 18rpx; border-radius: 10rpx;
}

/* 操作按钮 */
.action-section {
  margin: 40rpx 32rpx; display: flex; flex-direction: column; gap: 20rpx;
}
.action-btn {
  text-align: center; padding: 24rpx; border-radius: 14rpx;
  font-size: 30rpx; color: #fff; font-weight: 500;
}
.action-btn.green { background: linear-gradient(135deg, #07c160, #06ad56); }
.action-btn.red {
  background: #fff; border: 2rpx solid #e54545; color: #e54545;
}
.action-btn.blue { background: linear-gradient(135deg, #1890ff, #40a9ff); }
