page {
  background-color: #ededed;
}

/* 顶部搜索 */
.header {
  background: #ededed;
  padding: 16rpx 24rpx;
  padding-top: calc(env(status-bar-height) + 12rpx);
}

.search-bar {
  background: #fff;
  border-radius: 8rpx;
  padding: 14rpx 20rpx;
  display: flex;
  align-items: center;
}

.search-placeholder {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #999;
}

/* 功能区域 */
.func-section {
  background: #fff;
}

.func-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.func-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.func-svg {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) invert(1);
}

.new-friend-icon { background: linear-gradient(135deg, #ff6b6b, #ee5a24); }
.group-icon { background: linear-gradient(135deg, #52c41a, #73d13d); }
.tag-icon { background: linear-gradient(135deg, #1890ff, #40a9ff); }
.oa-icon { background: linear-gradient(135deg, #722ed1, #9254de); }

.func-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.func-right {
  display: flex;
  align-items: center;
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: #e54545;
  border-radius: 16rpx;
  padding: 0 8rpx;
  margin-right: 12rpx;
}

.arrow {
  color: #ccc;
  font-size: 28rpx;
}

/* 好友列表 */
.friend-list {
  height: calc(100vh - 340rpx);
  background: #fff;
}

.section-header {
  padding: 10rpx 28rpx;
  background: #ededed;
  font-size: 24rpx;
  color: #888;
  position: sticky;
  top: 0;
  z-index: 2;
}

.friend-item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background: #fff;
}

.friend-item:active {
  background: #f0f0f0;
}

.friend-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 10rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.friend-info {
  flex: 1;
  min-width: 0;
}

.friend-name {
  font-size: 30rpx;
  color: #333;
  display: block;
}

.friend-signature {
  font-size: 24rpx;
  color: #999;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧字母索引 */
.index-bar {
  position: fixed;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 99;
  padding: 10rpx 0;
}

.index-item {
  width: 44rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 20rpx;
  color: #666;
  border-radius: 18rpx;
}

.index-item.active {
  color: #07c160;
  font-weight: bold;
  font-size: 26rpx;
  background: rgba(7, 193, 96, 0.15);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  background: #fff;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-svg {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.35;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #bbb;
}
