page { background: #ededed; }
.top-tip {
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #999;
}
.request-list { height: calc(100vh - 60rpx); background: #fff; }
.request-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.req-avatar {
  width: 96rpx; height: 96rpx;
  border-radius: 12rpx; margin-right: 24rpx; flex-shrink: 0;
}
.req-info { flex: 1; min-width: 0; }
.req-name { font-size: 30rpx; color: #333; display: block; margin-bottom: 6rpx; }
.req-msg { font-size: 26rpx; color: #666; display: block; margin-bottom: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.req-time { font-size: 22rpx; color: #bbb; display: block; }
.req-actions { display: flex; gap: 16rpx; flex-shrink: 0; }
.btn {
  padding: 12rpx 32rpx; border-radius: 8rpx; font-size: 26rpx;
}
.btn-accept { background: #07c160; color: #fff; }
.btn-reject { background: #f0f0f0; color: #666; }
.status-text { font-size: 26rpx; flex-shrink: 0; }
.accepted { color: #07c160; }
.rejected { color: #999; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.empty-svg { width: 120rpx; height: 120rpx; margin-bottom: 20rpx; opacity: 0.35; }
.empty-text { font-size: 30rpx; color: #999; }
