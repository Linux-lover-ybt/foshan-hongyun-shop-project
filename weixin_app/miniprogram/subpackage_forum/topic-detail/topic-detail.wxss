/* subpackage_forum/topic-detail/topic-detail.wxss */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #999;
  font-size: 28rpx;
}

/* 话题头部 */
.topic-header {
  background: #fff;
  padding: 30rpx 30rpx 20rpx;
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.author-detail {
  flex: 1;
  margin-left: 20rpx;
}

.author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.author-tag {
  font-size: 20rpx;
  color: #fff;
  background: #b92629;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
  margin-left: 12rpx;
  vertical-align: middle;
}

.author-badge {
  margin-top: 6rpx;
}

.post-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.more-btn {
  padding: 10rpx 20rpx;
  font-size: 36rpx;
  color: #999;
  letter-spacing: 4rpx;
}

/* 正文 */
.topic-content {
  background: #fff;
  padding: 20rpx 30rpx 30rpx;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
}

.topic-tag {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b92629;
  background: #fef0f0;
  padding: 6rpx 18rpx;
  border-radius: 14rpx;
}

/* 图片 */
.topic-images {
  background: #fff;
  padding: 0 30rpx 30rpx;
}

.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.grid-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
}

.images-single .single {
  width: 100%;
  height: auto;
  max-height: 600rpx;
  border-radius: 12rpx;
}

/* 互动栏 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #fff;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
}

.action-icon {
  font-size: 36rpx;
}

.action-text {
  font-size: 26rpx;
  color: #666;
}

.share-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  font-size: inherit;
}

.share-btn::after {
  border: none;
}

/* 分割线 */
.divider {
  height: 16rpx;
  background: #f5f5f5;
}

/* 评论区 */
.comments-header {
  background: #fff;
  padding: 24rpx 30rpx 12rpx;
}

.comments-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.comments-list {
  background: #fff;
  padding: 0 30rpx 30rpx;
}

.comment-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-main {
  display: flex;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  margin-left: 16rpx;
}

.comment-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.mini {
  font-size: 18rpx;
  padding: 1rpx 10rpx;
}

.comment-delete {
  margin-left: auto;
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 12rpx;
}

.comment-text {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-top: 10rpx;
  word-break: break-all;
}

.comment-time {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.no-comments {
  text-align: center;
  padding: 60rpx 0;
  color: #ccc;
  font-size: 26rpx;
}

/* 底部评论输入 */
.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
}

.comment-send {
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #999;
  background: #f0f0f0;
  flex-shrink: 0;
}

.comment-send.active {
  color: #fff;
  background: #b92629;
}
