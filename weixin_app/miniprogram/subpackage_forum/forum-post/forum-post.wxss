.page { padding: 20rpx; background: #fff; min-height: 100vh; }

/* 任务提示 */
.task-tip {
  margin-bottom: 20rpx;
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tip-content {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #e54545 0%, #ff6b6b 100%);
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(229, 69, 69, 0.3);
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}

.header .title { font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; }
.form .form-item { margin-bottom: 20rpx; }
.label { font-size: 26rpx; color: #333; margin-bottom: 8rpx; }
.input, .textarea { width: 100%; border: 1rpx solid #eee; padding: 18rpx; border-radius: 4rpx; }
.textarea { height: 260rpx; resize: none; }
.images { display: flex; gap: 12rpx; flex-wrap: wrap; }
.thumb { width: 160rpx; height: 120rpx; border-radius: 6rpx; }
.add { width: 160rpx; height: 120rpx; display:flex; align-items:center; justify-content:center; border:1rpx dashed #ccc; color:#999; border-radius:6rpx; }
.actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.btn-primary { flex: 1; background: #e54545; color: #fff; padding: 18rpx; border-radius: 6rpx; }
.btn-secondary { flex: 1; background: #f3f3f3; color: #333; padding: 18rpx; border-radius: 6rpx; }
