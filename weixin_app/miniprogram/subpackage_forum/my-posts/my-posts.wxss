/* subpackage_forum/my-posts/my-posts.wxss */

.page { min-height: 100vh; background: #f5f5f5; }

/* 统计 */
.stats-bar {
  display: flex;
  background: linear-gradient(135deg, #e54545, #ff6b6b);
  padding: 40rpx 30rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

/* Tab */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #b92629;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #b92629;
}

/* 列表 */
.list { padding: 16rpx 24rpx; }

.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.item-body {
  flex: 1;
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
  min-width: 0;
}

.item-cover {
  position: relative;
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.cover-img { width: 100%; height: 100%; }

.cover-badge {
  position: absolute;
  bottom: 6rpx;
  right: 6rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.cover-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 32rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.item-content {
  font-size: 26rpx;
  color: #666;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.meta-tag {
  font-size: 20rpx;
  color: #b92629;
  background: #fef0f0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.meta-stats {
  font-size: 20rpx;
  color: #bbb;
}

.item-time {
  font-size: 20rpx;
  color: #ccc;
  margin-top: 4rpx;
}

.item-action {
  flex-shrink: 0;
  padding: 20rpx 24rpx;
  border-left: 1rpx solid #f5f5f5;
}

.item-action text {
  font-size: 24rpx;
  color: #e54545;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #999; }

.loading-tip {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
