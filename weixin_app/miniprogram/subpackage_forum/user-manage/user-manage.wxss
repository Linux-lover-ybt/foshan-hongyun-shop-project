/* subpackage_forum/user-manage/user-manage.wxss */

.page { min-height: 100vh; background: #f5f5f5; }

/* 头像区 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx 40rpx;
  background: linear-gradient(135deg, #e54545, #ff6b6b);
}

.avatar-wrapper {
  position: relative;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.6);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

.user-nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 20rpx;
}

.user-role {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-top: 10rpx;
  background: rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.9);
}

.role-red_base,
.role-admin {
  background: rgba(255,215,0,0.3);
  color: #fff;
}

/* 分区 */
.section {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-row + .info-row {
  border-top: 1rpx solid #f8f8f8;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.info-value.points {
  color: #e54545;
  font-weight: 600;
}

.role-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #666;
}

.role-badge.role-red_base,
.role-badge.role-admin {
  background: #fef0f0;
  color: #b92629;
}

/* 编辑 */
.edit-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.edit-actions {
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  text-align: center;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-save {
  background: linear-gradient(135deg, #e54545, #b92629);
  color: #fff;
  font-weight: 600;
}

/* 菜单 */
.menu-section { padding: 0; }

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon { font-size: 36rpx; margin-right: 20rpx; }

.menu-text { flex: 1; font-size: 28rpx; color: #333; }

.menu-arrow { font-size: 36rpx; color: #ccc; }
