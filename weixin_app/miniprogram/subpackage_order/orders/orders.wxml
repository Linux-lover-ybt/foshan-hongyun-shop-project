<!--orders.wxml-->
<view class="container">
  <!-- 标签栏 -->
  <view class="tab-bar">
    <view 
      class="tab-item {{currentTab === item.key ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view class="order-item" wx:for="{{filteredOrders}}" wx:key="id">
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-no">订单号：{{item.id}}</view>
        <view class="order-status {{item.status}}">{{item.statusText}}</view>
      </view>

      <!-- 商品信息 -->
      <view class="product-info">
        <image class="product-image" src="{{item.productImage}}" mode="aspectFill"></image>
        <view class="product-detail">
          <view class="product-name">{{item.productName}}</view>
          <view class="product-price">¥{{item.productPrice}}</view>
        </view>
      </view>

      <!-- 订单信息 -->
      <view class="order-info">
        <view class="info-item">
          <text class="info-label">下单时间：</text>
          <text class="info-value">{{item.createTime}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">实付金额：</text>
          <text class="info-value price">¥{{item.productPrice}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions">
        <view class="btn btn-default" bindtap="goBack">联系客服</view>
        <view 
          class="btn btn-primary" 
          wx:if="{{item.status === 'pending'}}"
          data-id="{{item.id}}"
          bindtap="goToPay"
        >立即付款</view>
        <view 
          class="btn btn-primary" 
          wx:if="{{item.status === 'shipped'}}"
          data-id="{{item.id}}"
          bindtap="confirmReceive"
        >确认收货</view>
        <view 
          class="btn btn-default" 
          wx:if="{{item.status === 'completed'}}"
          data-id="{{item.id}}"
          bindtap="applyAfterSale"
        >申请售后</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredOrders.length === 0}}">
      <view class="empty-icon">📦</view>
      <view class="empty-text">暂无相关订单</view>
    </view>
  </view>
</view>
