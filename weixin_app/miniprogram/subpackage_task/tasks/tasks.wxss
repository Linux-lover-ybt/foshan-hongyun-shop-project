/* tasks.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.task-content {
  flex: 1;
  overflow-y: auto;
  width: 100%;
}

/* 顶部积分区域 */
.points-header {
  background: linear-gradient(135deg, #b92629 0%, #e54545 100%);
  padding: 40rpx 30rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.points-info {
  flex: 1;
}

.points-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.points-value {
  font-size: 48rpx;
  font-weight: bold;
}

.date-info {
  text-align: right;
}

.date-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 5rpx;
}

.date-value {
  font-size: 28rpx;
  font-weight: 500;
}

/* 任务列表 */
.task-list {
  padding: 0;
  margin: 0;
}

.task-section {
  background-color: #fff;
  border-radius: 0;
  overflow: hidden;
  margin: 0;
  width: 100%;
  box-sizing: border-box;
}

.section-header {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
}



/* 任务说明 */
.task-rules {
  background-color: #fff;
  border-radius: 0;
  padding: 24rpx 30rpx;
  margin: 0;
  width: 100%;
  box-sizing: border-box;
  margin-top: 20rpx;
}

.rules-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.rule-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.rule-item:last-child {
  margin-bottom: 0;
}
/* 任务列表样式 */
.task-items {
  padding: 0;
}

.task-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background-color: #fff;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.completed {
  opacity: 0.6;
}

.task-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.task-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fef0f0;
  border-radius: 12rpx;
}

.task-info {
  flex: 1;
}

.task-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.task-description {
  font-size: 24rpx;
  color: #999;
}

.task-right {
  display: flex;
  align-items: center;
}

.task-points {
  font-size: 32rpx;
  color: #e54545;
  font-weight: bold;
}

.task-completed {
  font-size: 26rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}