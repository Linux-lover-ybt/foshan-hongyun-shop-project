/* 全局样式变量 */

/* 颜色变量 */
:root {
  /* 主题色 */
  --color-primary: #b92629;
  --color-primary-light: #e54545;
  --color-primary-dark: #8e1e21;
  
  /* 辅助色 */
  --color-secondary: #666666;
  --color-light: #f5f5f5;
  --color-white: #ffffff;
  --color-black: #000000;
  
  /* 功能色 */
  --color-success: #07c160;
  --color-warning: #ff9500;
  --color-error: #ff3b30;
  --color-info: #007aff;
}

/* 尺寸变量 */
:root {
  /* 字体大小 */
  --font-size-xs: 20rpx;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  
  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-base: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  
  /* 圆角 */
  --border-radius-sm: 4rpx;
  --border-radius-base: 8rpx;
  --border-radius-lg: 16rpx;
  --border-radius-full: 9999rpx;
  
  /* 边框 */
  --border-width: 2rpx;
  --border-color: #e5e5e5;
}

/* 布局变量 */
:root {
  --header-height: 100rpx;
  --tabbar-height: 100rpx;
  --content-padding: 24rpx;
}
