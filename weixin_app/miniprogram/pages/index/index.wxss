/**index.wxss**/

page {
  background-color: #f8f9fa;
  font-family: PingFang SC, -apple-system, BlinkMacSystemFont, sans-serif;
}

.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1; /* 将背景置于最底层 */
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  box-sizing: border-box;
  padding-top: 45vh;
}

/* 核心功能区域 */
.functions-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.function-card {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  padding: 24rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  transition: all 0.2s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
  backdrop-filter: blur(8rpx);
}

.function-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #e54545 0%, #ff6b6b 100%);
  box-shadow: 0 4rpx 12rpx rgba(229, 69, 69, 0.3);
}

.card-icon.green {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.2);
}

.card-icon.blue {
  background: linear-gradient(135deg, #007aff 0%, #5ac8fa 100%);
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.2);
}

.card-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.card-icon-text {
  font-size: 32rpx;
}

.card-content {
  flex: 1;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 4rpx;
}

.card-desc {
  font-size: 20rpx;
  color: #95a5a6;
}

.card-arrow {
  font-size: 32rpx;
  color: #d0d0d0;
  font-weight: 300;
  margin-left: 8rpx;
}

.featured-section {
  width: 100%;
  display: flex;
  justify-content: space-around;
  gap: 20rpx;
}

.featured-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.65);
  border-radius: 16rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  backdrop-filter: blur(6rpx);
}

.featured-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.featured-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.featured-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.featured-icon-img {
  width: 64rpx;
  height: 64rpx;
}

.featured-text {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.featured-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 4rpx;
}

.featured-desc {
  font-size: 20rpx;
  color: #95a5a6;
}