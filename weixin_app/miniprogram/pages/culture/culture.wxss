/* culture.wxss - 工业级电商样式 */
page {
  background: #f5f5f5;
  min-height: 100vh;
}

.page {
  padding-bottom: 40rpx;
  min-height: 100vh;
}

/* ========== 搜索栏 ========== */
.search-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: linear-gradient(135deg, #c41e3a 0%, #e54545 50%, #ff6b6b 100%);
  padding: 12rpx 24rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(196, 30, 58, 0.3);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-bar-inner {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 36rpx;
  padding: 12rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin-left: 12rpx;
  color: #333;
}

.search-placeholder {
  color: #bbb;
  font-size: 26rpx;
}

.search-clear {
  display: flex;
  align-items: center;
  margin-left: 8rpx;
}

.search-btn {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border-radius: 36rpx;
  white-space: nowrap;
}

.search-btn:active {
  background: rgba(255, 255, 255, 0.4);
}

/* 搜索栏购物车 */
.header-cart {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-svg {
  width: 40rpx;
  height: 40rpx;
}

.header-cart-badge {
  position: absolute;
  top: 2rpx;
  right: 0;
  background: #fff;
  color: #e54545;
  font-size: 18rpx;
  font-weight: 700;
  padding: 0 8rpx;
  border-radius: 16rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
}

/* 搜索历史 */
.search-history {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 0 0 16rpx 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 8rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.history-clear {
  font-size: 24rpx;
  color: #999;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.history-tag {
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* ========== 轮播图 ========== */
.swiper-wrap {
  padding: 16rpx 24rpx 0;
}

.swiper {
  width: 100%;
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.swiper-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.banner-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 12rpx;
}

.banner-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ========== 优惠券入口 ========== */
.coupon-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff5f5, #ffe8e8);
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #ffcccc;
}

.coupon-entry-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.coupon-icon {
  width: 36rpx;
  height: 36rpx;
}

.coupon-text {
  font-size: 26rpx;
  color: #666;
}

.coupon-save {
  font-size: 32rpx;
  font-weight: 800;
  color: #e54545;
}

.coupon-entry-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #e54545;
  font-weight: 600;
}

.coupon-arrow {
  font-size: 24rpx;
}

/* ========== 分类入口 ========== */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 20rpx;
  background: #fff;
  margin: 16rpx 24rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.cat-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.cat-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s;
}

.cat-icon-wrap.cat-active {
  transform: scale(1.1);
  box-shadow: 0 6rpx 20rpx rgba(229, 69, 69, 0.3);
}

.cat-emoji {
  width: 44rpx;
  height: 44rpx;
}

.cat-name {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
}

.cat-name-active {
  color: #e54545;
  font-weight: 700;
}

/* ========== 限时秒杀 ========== */
.flash-sale {
  background: #fff;
  margin: 16rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.flash-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.flash-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.flash-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #c41e3a;
}

.flash-icon {
  width: 32rpx;
  height: 32rpx;
  vertical-align: middle;
}

.flash-countdown {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.countdown-block {
  background: #333;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  min-width: 44rpx;
  text-align: center;
}

.countdown-sep {
  font-size: 22rpx;
  font-weight: 700;
  color: #333;
}

.flash-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #999;
}

.arrow {
  font-size: 24rpx;
}

/* 秒杀横向滚动 */
.flash-scroll {
  white-space: nowrap;
}

.flash-list {
  display: flex;
  gap: 16rpx;
}

.flash-item {
  width: 220rpx;
  flex-shrink: 0;
  background: #fafafa;
  border-radius: 16rpx;
  overflow: hidden;
}

.flash-img-wrap {
  width: 100%;
  height: 180rpx;
  position: relative;
  background: #f0f0f0;
}

.flash-img {
  width: 100%;
  height: 100%;
}

.flash-badge {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #ff4444, #e54545);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 0 0 12rpx 0;
}

.flash-info {
  padding: 12rpx;
}

.flash-name {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.flash-price-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.flash-symbol {
  font-size: 20rpx;
  color: #e54545;
  font-weight: 700;
}

.flash-price-num {
  font-size: 28rpx;
  color: #e54545;
  font-weight: 800;
}

.flash-original {
  font-size: 18rpx;
  color: #ccc;
  text-decoration: line-through;
}

.flash-progress-wrap {
  height: 8rpx;
  background: #ffe0e0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.flash-progress {
  height: 100%;
  background: linear-gradient(90deg, #ff4444, #e54545);
  border-radius: 4rpx;
}

.flash-buy-btn {
  background: linear-gradient(135deg, #e54545, #c41e3a);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  padding: 6rpx 0;
  border-radius: 20rpx;
}

.flash-buy-btn:active {
  opacity: 0.8;
}

/* ========== 热门排行 ========== */
.hot-section {
  background: #fff;
  margin: 16rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.section-icon {
  width: 32rpx;
  height: 32rpx;
  vertical-align: middle;
}

.section-sub {
  font-size: 22rpx;
  color: #999;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #999;
}

.hot-scroll {
  white-space: nowrap;
}

.hot-list {
  display: flex;
  gap: 16rpx;
}

.hot-item {
  width: 200rpx;
  flex-shrink: 0;
  background: #fafafa;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.hot-rank {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  background: #999;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 12rpx 0;
}

.hot-rank.rank-top {
  background: linear-gradient(135deg, #ff6b6b, #e54545);
}

.hot-img-wrap {
  width: 100%;
  height: 160rpx;
  background: #f0f0f0;
}

.hot-img {
  width: 100%;
  height: 100%;
}

.hot-info {
  padding: 10rpx;
}

.hot-name {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.hot-price-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  margin-bottom: 4rpx;
}

.hot-symbol {
  font-size: 18rpx;
  color: #e54545;
  font-weight: 700;
}

.hot-price {
  font-size: 26rpx;
  color: #e54545;
  font-weight: 800;
}

.hot-sales {
  font-size: 18rpx;
  color: #999;
}

/* ========== 新品推荐 ========== */
.new-section {
  background: #fff;
  margin: 16rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.new-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.new-item {
  width: calc(25% - 12rpx);
  margin: 6rpx;
  background: #fafafa;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.new-img-wrap {
  width: 100%;
  height: 140rpx;
  position: relative;
  background: #f0f0f0;
}

.new-img {
  width: 100%;
  height: 100%;
}

.new-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  background: linear-gradient(135deg, #8e44ad, #9b59b6);
  color: #fff;
  font-size: 16rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.new-info {
  padding: 8rpx;
}

.new-name {
  font-size: 20rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}

.new-price-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.new-symbol {
  font-size: 18rpx;
  color: #e54545;
  font-weight: 700;
}

.new-price {
  font-size: 22rpx;
  color: #e54545;
  font-weight: 800;
}

.new-original {
  font-size: 20rpx;
  color: #ccc;
  text-decoration: line-through;
}

/* ========== 积分专区 ========== */
.points-section {
  margin: 16rpx 24rpx 0;
}

.points-banner {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.points-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.points-icon {
  width: 44rpx;
  height: 44rpx;
}

.points-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.points-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffd700;
}

.points-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ========== 分类标签栏 ========== */
.tab-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  margin-top: 16rpx;
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  position: relative;
}

.tab-item.active {
  background: linear-gradient(135deg, #c41e3a, #e54545);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(196, 30, 58, 0.3);
}

.price-arrow {
  font-size: 20rpx;
  margin-left: 4rpx;
}

.price-arrow::before {
  content: '';
  display: inline-block;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  margin: 0 2rpx;
}

.price-arrow.up::before {
  border-bottom: 8rpx solid #666;
  margin-bottom: 4rpx;
}

.price-arrow.down::before {
  border-top: 8rpx solid #666;
}

.tab-item.active .price-arrow.up::before,
.tab-item.active .price-arrow.down::before {
  border-color: #fff;
}

/* ========== 商品瀑布流 ========== */
.goods-waterfall {
  display: flex;
  padding: 16rpx 12rpx;
  gap: 12rpx;
}

.goods-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.goods-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.goods-card:active {
  transform: scale(0.98);
}

.goods-img-wrap {
  width: 100%;
  background: #f5f5f5;
  position: relative;
  overflow: hidden;
}

.goods-img {
  width: 100%;
  display: block;
}

.goods-tag {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #c41e3a, #e54545);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx 4rpx 8rpx;
  border-radius: 0 0 16rpx 0;
}

.goods-tag-new {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #8e44ad, #9b59b6);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx 4rpx 8rpx;
  border-radius: 0 0 16rpx 0;
}

.goods-info {
  padding: 16rpx;
}

.goods-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.goods-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.goods-mini-tag {
  font-size: 18rpx;
  color: #e54545;
  background: #fff5f5;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  border: 1rpx solid #ffcccc;
}

.goods-shop {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 10rpx;
}

.shop-icon {
  width: 24rpx;
  height: 24rpx;
}

.shop-name {
  font-size: 20rpx;
  color: #e54545;
  font-weight: 600;
  background: #fff5f5;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  border: 1rpx solid #ffcccc;
}

.goods-comments {
  font-size: 20rpx;
  color: #999;
  margin-left: auto;
}

.goods-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.goods-price-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.goods-symbol {
  font-size: 22rpx;
  color: #e54545;
  font-weight: 700;
}

.goods-price {
  font-size: 36rpx;
  color: #e54545;
  font-weight: 800;
  margin-right: 8rpx;
}

.goods-original {
  font-size: 22rpx;
  color: #ccc;
  text-decoration: line-through;
}

.goods-cart-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c41e3a, #e54545);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(196, 30, 58, 0.35);
}

.goods-cart-btn:active {
  transform: scale(0.9);
}

.cart-icon-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: -2rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #c41e3a, #e54545);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 16rpx 48rpx;
  border-radius: 36rpx;
}

/* ========== 加载更多 ========== */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999;
}

/* ========== 悬浮购物车 ========== */
.float-cart {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c41e3a, #e54545);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(196, 30, 58, 0.4);
  z-index: 90;
}

.float-cart:active {
  transform: scale(0.92);
}

.float-cart-icon {
  width: 44rpx;
  height: 44rpx;
}

.float-cart-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: #ff4444;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  min-width: 28rpx;
  text-align: center;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(255, 68, 68, 0.5);
}

/* ========== 回到顶部 ========== */
.float-top {
  position: fixed;
  right: 32rpx;
  bottom: 100rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  z-index: 90;
  font-size: 32rpx;
  color: #666;
  font-weight: 700;
}

.float-top:active {
  background: #f5f5f5;
  transform: scale(0.92);
}

/* ========== 优惠券弹窗 ========== */
.coupon-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.coupon-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 201;
  max-height: 70vh;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.coupon-popup-show {
  transform: translateY(0);
}

.coupon-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.coupon-popup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.coupon-popup-icon {
  width: 32rpx;
  height: 32rpx;
  vertical-align: middle;
}

.coupon-popup-close {
  font-size: 36rpx;
  color: #999;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon-popup-list {
  padding: 24rpx 32rpx;
  max-height: 55vh;
}

.coupon-card {
  display: flex;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.coupon-left {
  width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  color: #fff;
}

.coupon-amount {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.coupon-condition {
  font-size: 20rpx;
  margin-top: 8rpx;
  opacity: 0.85;
}

.coupon-right {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #fff;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.coupon-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.coupon-claim-btn {
  align-self: flex-start;
  background: linear-gradient(135deg, #c41e3a, #e54545);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.coupon-claim-btn.claimed {
  background: #ddd;
  color: #999;
}

.coupon-claim-btn:active:not(.claimed) {
  opacity: 0.8;
}
