<!--pages/login/login.wxml-->
<view class="container">
  <view class="bg-decoration"></view>
  <view class="skip-btn" bindtap="handleSkip">跳过</view>

  <view class="header">
    <view class="logo-wrapper">
      <view class="logo-icon">
        <text>红</text>
      </view>
    </view>
    <text class="title">欢迎回来</text>
    <text class="subtitle">红色文化传承，从这里开始</text>
  </view>

  <view class="card-wrapper">
    <view class="card">
      <view class="tabs">
        <view class="tab-item {{loginType === 'code' ? 'active' : ''}}" bindtap="switchLoginType" data-type="code">验证码登录</view>
        <view class="tab-item {{loginType === 'password' ? 'active' : ''}}" bindtap="switchLoginType" data-type="password">密码登录</view>
      </view>

      <view class="login-form">
        <!-- 验证码登录 -->
        <block wx:if="{{loginType === 'code'}}">
          <view class="input-wrapper">
            <view class="input-icon">
              <text class="icon-phone"></text>
            </view>
            <input class="input" type="number" placeholder="请输入手机号码" maxlength="11" bindinput="handleInput" data-field="phone" />
          </view>
          <view class="code-section">
            <view class="input-wrapper">
              <view class="input-icon">
                <text class="icon-code"></text>
              </view>
              <input class="input" type="number" placeholder="请输入验证码" maxlength="6" bindinput="handleInput" data-field="code" />
            </view>
            <view class="verify-btn-wrapper">
              <button class="verify-btn" disabled="{{counting}}" bindtap="getVerifyCode">
                {{counting ? count + 's后重发' : '获取验证码'}}
              </button>
            </view>
          </view>
        </block>

        <!-- 密码登录 -->
        <block wx:if="{{loginType === 'password'}}">
          <view class="input-wrapper">
            <view class="input-icon">
              <text class="icon-user"></text>
            </view>
            <input class="input" type="text" placeholder="请输入手机号/用户名" bindinput="handleInput" data-field="username" />
          </view>
          <view class="input-wrapper">
            <view class="input-icon">
              <text class="icon-lock"></text>
            </view>
            <input class="input" password type="text" placeholder="请输入密码" bindinput="handlePasswordInput" />
          </view>
          <view class="password-strength">
            <view class="strength-label">密码强度</view>
            <view class="strength-bars">
              <view class="strength-bar-item {{passwordStrength > 0 ? 'active' : ''}}" style="background-color: {{strengthColor}}"></view>
              <view class="strength-bar-item {{passwordStrength > 1 ? 'active' : ''}}" style="background-color: {{strengthColor}}"></view>
              <view class="strength-bar-item {{passwordStrength > 2 ? 'active' : ''}}" style="background-color: {{strengthColor}}"></view>
            </view>
          </view>
        </block>

        <button class="login-btn" bindtap="handleLogin" loading="{{loading}}">登 录</button>
      </view>

      <view class="extra-actions">
        <view class="agreement">
          <checkbox class="agree-checkbox" value="agree" checked="{{isAgreed}}" bindtap="toggleAgree"></checkbox>
          <text class="agree-text">我已阅读并同意</text>
          <navigator class="link" url="/pages/agreement/agreement">《用户协议》</navigator>
        </view>
        <navigator wx:if="{{loginType === 'password'}}" class="link forgot-password" url="/pages/forgot/forgot">忘记密码?</navigator>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">还没有账号？</text>
    <navigator class="link" url="/pages/register/register">立即注册</navigator>
  </view>
</view>
