page {
  background: #f5f5f5;
  min-height: 100vh;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* ========== 头部背景 ========== */
.header-section {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.header-overlay {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.header-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.header-badge {
  background: linear-gradient(135deg, #c41e3a, #e54545);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(196, 30, 58, 0.35);
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 4rpx;
}

/* ========== MBTI测试横幅 ========== */
.mbti-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(102, 126, 234, 0.35);
  position: relative;
  overflow: hidden;
}

.mbti-banner::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.mbti-banner::after {
  content: '';
  position: absolute;
  bottom: -40%;
  left: 10%;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.mbti-banner-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.mbti-banner-icon {
  font-size: 56rpx;
}

.mbti-banner-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.mbti-banner-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.mbti-banner-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.mbti-banner-arrow {
  position: relative;
  z-index: 1;
}

.mbti-arrow {
  font-size: 48rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.9);
}

/* ========== 名人列表 ========== */
.figure-list {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

/* ========== 人物卡片 ========== */
.figure-card {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.25s ease;
}

.figure-card:active {
  transform: scale(0.98);
}

.card-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.figure-icon-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.figure-icon-img {
  width: 90rpx;
  height: 90rpx;
}

/* Emoji 图标 */
.figure-emoji {
  font-size: 56rpx;
}

.figure-basic {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.figure-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #222;
}

.figure-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 18rpx;
  border-radius: 8rpx;
  align-self: flex-start;
  border-width: 1rpx;
  border-style: solid;
}

/* ========== 详情内容 ========== */
.figure-content {
  padding: 24rpx 28rpx 28rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  width: 80rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.info-value {
  font-size: 24rpx;
  color: #444;
}

.info-desc {
  margin-top: 14rpx;
  padding: 18rpx 22rpx;
  background: #fafafa;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #555;
  line-height: 1.7;
  border-left: 5rpx solid var(--accent, #c41e3a);
}

/* ========== 名字行 + MBTI标签 ========== */
.figure-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mbti-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #764ba2;
  background: rgba(118, 75, 162, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

/* ========== 成就标签 ========== */
.figure-achievements {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.achievement-tag {
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  font-weight: 500;
  border: 1rpx solid;
}

/* ========== 详情弹窗 ========== */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.detail-popup {
  position: fixed;
  left: 0; right: 0; bottom: -100%;
  height: 80vh;
  z-index: 101;
  display: flex;
  flex-direction: column;
  border-radius: 36rpx 36rpx 0 0;
  overflow: hidden;
  transition: bottom 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.18);
}

.detail-popup.show {
  bottom: 0;
}

/* 弹窗头部 */
.detail-header {
  position: relative;
  padding: 40rpx 32rpx 36rpx;
  flex-shrink: 0;
}

.detail-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.detail-close text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 300;
}

.detail-header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.detail-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}

.detail-icon-img {
  width: 110rpx;
  height: 110rpx;
}

.detail-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.detail-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.detail-mbti {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 22rpx;
  border-radius: 12rpx;
}

.detail-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
}

/* 弹窗内容区 */
.detail-body {
  flex: 1;
  height: 0;
  background: #f7f7f7;
  padding: 0 28rpx;
}

.detail-section {
  margin-top: 28rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 18rpx;
  position: relative;
  padding-left: 18rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #667eea, #764ba2);
  border-radius: 3rpx;
}

.detail-info-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-info-item {
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
  background: #fff;
  border-radius: 14rpx;
}

.detail-info-label {
  font-size: 24rpx;
  color: #999;
  width: 80rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.detail-info-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.detail-desc-box {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx 22rpx;
}

.detail-full-desc {
  font-size: 26rpx;
  color: #555;
  line-height: 1.85;
}

.detail-traits {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.trait-pill {
  font-size: 23rpx;
  font-weight: 500;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid;
}

.detail-achieve-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.achieve-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  background: #fff;
  border-radius: 14rpx;
  border-left: 5rpx solid;
}

.achieve-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.achieve-text {
  font-size: 26rpx;
  color: #444;
  font-weight: 500;
}

.detail-bottom-space {
  height: 60rpx;
}
