/* pages/cart/cart.wxss - 工业级购物车 */
page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.page {
  min-height: 100vh;
}

/* ========== 空状态 ========== */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-shop-btn {
  background: linear-gradient(135deg, #c41e3a, #e54545);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 80rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(196, 30, 58, 0.3);
}

.go-shop-btn:active {
  opacity: 0.85;
}

/* ========== 购物车区域 ========== */
.cart-section {
  padding-bottom: 20rpx;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
  background: #fff;
}

.cart-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.cart-edit {
  font-size: 28rpx;
  color: #e54545;
  font-weight: 500;
}

/* ========== 优惠券提示 ========== */
.coupon-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #fff5f5, #ffe8e8);
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #ffcccc;
}

.coupon-tip-icon {
  font-size: 28rpx;
}

.coupon-tip-text {
  font-size: 24rpx;
  color: #e54545;
}

/* ========== 购物车列表 ========== */
.cart-list {
  padding: 0 24rpx;
  background: #fff;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
  transition: background 0.2s;
}

.cart-item.item-selected {
  background: #fffbfb;
}

/* 选择框 */
.item-check {
  padding-right: 16rpx;
  flex-shrink: 0;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.2s;
}

.check-box.checked {
  background: linear-gradient(135deg, #c41e3a, #e54545);
  border-color: #e54545;
}

/* 商品图片 */
.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f5f5f5;
}

.item-image image {
  width: 100%;
  height: 100%;
}

/* 商品信息 */
.item-info {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.item-spec {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  align-self: flex-start;
  margin-bottom: 12rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #e54545;
  font-weight: 600;
}

.price-value {
  font-size: 32rpx;
  color: #e54545;
  font-weight: 700;
}

.item-original {
  font-size: 20rpx;
  color: #ff8c00;
  margin-top: 6rpx;
}

/* 数量控制 */
.item-quantity {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.quantity-btn {
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
  background: #fafafa;
}

.quantity-btn:active {
  background: #f0f0f0;
}

.quantity-input {
  width: 64rpx;
  height: 48rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
}

/* 删除按钮 */
.item-delete {
  position: absolute;
  top: 16rpx;
  right: 0;
  font-size: 28rpx;
  color: #ccc;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-delete:active {
  color: #e54545;
}

/* ========== 推荐区域 ========== */
.recommend-section {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.recommend-header {
  margin-bottom: 12rpx;
}

.recommend-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.recommend-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.recommend-btn {
  background: linear-gradient(135deg, #c41e3a, #e54545);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 16rpx 60rpx;
  border-radius: 36rpx;
  display: inline-block;
  box-shadow: 0 4rpx 16rpx rgba(196, 30, 58, 0.3);
}

.recommend-btn:active {
  opacity: 0.85;
}

/* ========== 底部结算栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.all-check {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.all-check-text {
  font-size: 28rpx;
  color: #333;
}

.total-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-right: 24rpx;
}

.total-price-row {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-symbol {
  font-size: 26rpx;
  color: #e54545;
  font-weight: 600;
}

.total-value {
  font-size: 36rpx;
  color: #e54545;
  font-weight: 800;
}

.saved-info {
  font-size: 20rpx;
  color: #ff8c00;
  margin-top: 4rpx;
}

.bar-action-btn {
  background: linear-gradient(135deg, #c41e3a, #e54545);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(196, 30, 58, 0.3);
  white-space: nowrap;
}

.bar-action-btn.disabled {
  background: #ccc;
  box-shadow: none;
}

.bar-action-btn:active:not(.disabled) {
  opacity: 0.85;
}
