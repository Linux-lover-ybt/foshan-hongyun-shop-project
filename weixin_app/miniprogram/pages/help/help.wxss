/* pages/help/help.wxss */
.page-container {
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 160rpx;
}

/* 顶部标题区 */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(180deg, #e54545 0%, #d63030 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  background: #fff;
  margin: -32rpx 24rpx 24rpx;
  padding: 32rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
}

.action-name {
  font-size: 24rpx;
  color: #666;
}

/* 分类标签 */
.category-tabs {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.tabs-scroll {
  white-space: nowrap;
}

.tabs-inner {
  display: inline-flex;
  gap: 16rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  background: #e54545;
  color: #fff;
  font-weight: 500;
}

/* FAQ区域 */
.faq-section {
  padding: 0 24rpx;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.faq-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.faq-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
}

.faq-q {
  display: flex;
  align-items: flex-start;
  flex: 1;
}

.q-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #e54545, #d63030);
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.q-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.5;
}

.faq-arrow {
  font-size: 36rpx;
  color: #ccc;
  transition: transform 0.3s;
  margin-left: 16rpx;
}

.faq-arrow.expanded {
  transform: rotate(90deg);
}

.faq-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-out;
}

.faq-content.show {
  max-height: 600rpx;
}

.faq-a {
  display: flex;
  align-items: flex-start;
  padding: 0 24rpx 28rpx;
}

.a-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: #f0f7ff;
  color: #1976d2;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.a-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

/* 空状态 */
.empty-faq {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  background: #fff;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 联系卡片 */
.contact-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.card-subtitle {
  font-size: 24rpx;
  color: #999;
}

.contact-list {
  padding: 8rpx 0;
}

.contact-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.contact-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  box-sizing: content-box;
}

.contact-icon.email {
  background: #e3f2fd;
}

.contact-icon.phone {
  background: #e8f5e9;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
}

.contact-action {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 24rpx;
}

.contact-action.primary {
  background: linear-gradient(135deg, #e54545, #d63030);
  color: #fff;
}

/* 底部入口 */
.bottom-entry {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 28rpx 40rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.entry-content {
  display: flex;
  align-items: center;
}

.entry-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.entry-text {
  font-size: 28rpx;
  color: #333;
}

.entry-arrow {
  font-size: 32rpx;
  color: #e54545;
}
