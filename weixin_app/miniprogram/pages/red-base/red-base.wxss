/* pages/red-base/red-base.wxss */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.points-badge {
  font-size: 22rpx;
  color: #b92629;
  background: #fef0f0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 话题/视频 主Tab */
.main-tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.main-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
  transition: color 0.2s;
}

.main-tab.active {
  color: #b92629;
  font-weight: 700;
}

.main-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #b92629;
}

/* 栏目分类标签 */
.tags-scroll {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 24rpx;
}

.tags-inner {
  display: inline-flex;
  gap: 14rpx;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  white-space: nowrap;
}

.tag-item.active {
  color: #fff;
  background: #b92629;
  font-weight: 600;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
}

.sort-btn {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  color: #666;
  background: #f0f0f0;
}

.sort-btn.active {
  color: #fff;
  background: #b92629;
}

/* ========== 话题瀑布流 ========== */
.waterfall {
  display: flex;
  padding: 16rpx;
  gap: 16rpx;
}

.waterfall-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.topic-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-cover {
  position: relative;
  width: 100%;
}

.cover-image {
  width: 100%;
  display: block;
}

.cover-count {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.card-body {
  padding: 16rpx;
}

.card-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  word-break: break-all;
}

.card-tag {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b92629;
  background: #fef0f0;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.card-author {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.author-name {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 6rpx 10rpx;
}

.card-like.liked .like-icon {
  transform: scale(1.1);
}

.like-icon {
  font-size: 28rpx;
}

.like-count {
  font-size: 22rpx;
  color: #999;
}

/* ========== 视频列表 ========== */
.video-list {
  padding: 16rpx;
}

.video-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.video-cover {
  position: relative;
  width: 280rpx;
  min-height: 200rpx;
  flex-shrink: 0;
}

.video-cover-img {
  width: 100%;
  height: 100%;
}

.video-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-btn {
  color: #fff;
  font-size: 28rpx;
  margin-left: 6rpx;
}

.video-views {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.video-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.video-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.video-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.video-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.meta-category {
  font-size: 22rpx;
  color: #b92629;
  background: #fef0f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.meta-time {
  font-size: 22rpx;
  color: #bbb;
}

/* ========== 公共 ========== */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
}

/* 浮动发布按钮 */
.fab-publish {
  position: fixed;
  right: 40rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e54545, #b92629);
  box-shadow: 0 8rpx 24rpx rgba(185, 38, 41, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.fab-icon {
  font-size: 52rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
