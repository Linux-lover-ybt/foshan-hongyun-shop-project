/* pages/my-orders/my-orders.wxss */
.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* Tab */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 10rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #e54545;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #e54545;
  border-radius: 2rpx;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 订单卡片 */
.order-card {
  background: #fff;
  margin: 20rpx 20rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

/* 商品 */
.order-items {
  padding: 16rpx 24rpx;
}

.order-item {
  display: flex;
  padding: 12rpx 0;
}

.item-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.item-price {
  font-size: 28rpx;
  color: #e54545;
  font-weight: 600;
}

.item-qty {
  font-size: 24rpx;
  color: #999;
}

/* 底部 */
.order-footer {
  padding: 16rpx 24rpx 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.order-total {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 16rpx;
}

.total-label {
  font-size: 24rpx;
  color: #666;
}

.total-price {
  font-size: 32rpx;
  color: #e54545;
  font-weight: 700;
  margin-left: 8rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.action-btn {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  border: 1rpx solid #ddd;
  color: #666;
}

.pay-btn {
  background: #e54545;
  color: #fff;
  border-color: #e54545;
}

.confirm-btn {
  background: #e54545;
  color: #fff;
  border-color: #e54545;
}

.logistics-btn {
  border-color: #e54545;
  color: #e54545;
}

.cancel-btn {
  color: #999;
  border-color: #ddd;
}

.order-time {
  font-size: 22rpx;
  color: #ccc;
  padding: 0 24rpx 16rpx;
  text-align: right;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 物流弹窗 */
.logistics-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.logistics-popup {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.logistics-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.logistics-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.logistics-close {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.logistics-company {
  padding: 20rpx 32rpx;
  background: #f9f9f9;
  font-size: 26rpx;
  color: #666;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.logistics-traces {
  padding: 20rpx 32rpx 40rpx;
  max-height: 50vh;
}

.trace-item {
  display: flex;
  position: relative;
  padding-bottom: 30rpx;
  padding-left: 36rpx;
}

.trace-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e54545;
  z-index: 1;
}

.trace-dot:first-child {
  background: #e54545;
  width: 20rpx;
  height: 20rpx;
  top: 6rpx;
  left: -2rpx;
}

.trace-line {
  position: absolute;
  left: 7rpx;
  top: 28rpx;
  bottom: 0;
  width: 2rpx;
  background: #eee;
}

.trace-content {
  flex: 1;
}

.trace-desc {
  font-size: 26rpx;
  color: #333;
  display: block;
  line-height: 1.5;
}

.trace-time {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.no-traces {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}
