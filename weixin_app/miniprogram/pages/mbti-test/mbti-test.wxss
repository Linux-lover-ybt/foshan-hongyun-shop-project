page {
  background: #f5f5f5;
  min-height: 100vh;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 进度条 ========== */
.progress-bar-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 32rpx 20rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
  white-space: nowrap;
}

/* ========== 题目区域 ========== */
.question-area {
  flex: 1;
  padding: 0 32rpx;
}

.dimension-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #764ba2;
  background: rgba(118, 75, 162, 0.08);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
}

.question-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

/* ========== 选项区域 ========== */
.options-area {
  margin-bottom: 40rpx;
}

.option-row {
  margin-bottom: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.25s ease;
}

.option-item.selected {
  border-color: #764ba2;
  background: linear-gradient(135deg, rgba(102,126,234,0.06), rgba(118,75,162,0.06));
  box-shadow: 0 4rpx 16rpx rgba(118, 75, 162, 0.15);
}

.option-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: border-color 0.25s ease;
}

.option-item.selected .option-circle {
  border-color: #764ba2;
}

.option-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.option-label {
  font-size: 30rpx;
  color: #444;
  font-weight: 500;
}

.option-item.selected .option-label {
  color: #764ba2;
  font-weight: 700;
}

/* ========== 按钮 ========== */
.btn-area {
  padding: 20rpx 0 60rpx;
}

.btn-next {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
  transition: opacity 0.25s ease;
}

.btn-next.disabled {
  opacity: 0.4;
  box-shadow: none;
}

/* ========== 结果区域 ========== */
.result-area {
  flex: 1;
  padding: 20rpx 32rpx 60rpx;
}

.result-type-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(102, 126, 234, 0.35);
}

.result-type-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.result-type {
  font-size: 80rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.result-type-name {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
  font-weight: 600;
}

/* ========== 维度进度条 ========== */
.dimensions-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.dim-item {
  margin-bottom: 32rpx;
}

.dim-item:last-child {
  margin-bottom: 0;
}

.dim-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dim-label {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.dim-label.active {
  color: #764ba2;
  font-weight: 700;
}

.dim-bar {
  display: flex;
  height: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.dim-fill {
  height: 100%;
  transition: width 0.6s ease;
}

.dim-fill-e { background: linear-gradient(90deg, #667eea, #8b9cf7); border-radius: 10rpx 0 0 10rpx; }
.dim-fill-i { background: linear-gradient(90deg, #a78bfa, #764ba2); border-radius: 0 10rpx 10rpx 0; }
.dim-fill-s { background: linear-gradient(90deg, #667eea, #8b9cf7); border-radius: 10rpx 0 0 10rpx; }
.dim-fill-n { background: linear-gradient(90deg, #a78bfa, #764ba2); border-radius: 0 10rpx 10rpx 0; }
.dim-fill-t { background: linear-gradient(90deg, #667eea, #8b9cf7); border-radius: 10rpx 0 0 10rpx; }
.dim-fill-f { background: linear-gradient(90deg, #a78bfa, #764ba2); border-radius: 0 10rpx 10rpx 0; }
.dim-fill-j { background: linear-gradient(90deg, #667eea, #8b9cf7); border-radius: 10rpx 0 0 10rpx; }
.dim-fill-p { background: linear-gradient(90deg, #a78bfa, #764ba2); border-radius: 0 10rpx 10rpx 0; }

.dim-score {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* ========== 名人匹配卡片 ========== */
.figure-match-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.match-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.match-icon {
  font-size: 32rpx;
}

.match-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.match-figure {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.match-figure-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.match-figure-img {
  width: 90rpx;
  height: 90rpx;
}

.match-figure-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.match-figure-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #222;
}

.match-figure-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.match-traits {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.trait-tag {
  font-size: 22rpx;
  color: #764ba2;
  background: rgba(118, 75, 162, 0.06);
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(118, 75, 162, 0.15);
}

/* ========== 操作按钮 ========== */
.result-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.btn-retest {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}

.btn-back {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #764ba2;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  border: 2rpx solid #764ba2;
}
