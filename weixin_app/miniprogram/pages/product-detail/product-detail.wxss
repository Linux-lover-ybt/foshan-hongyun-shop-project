/* pages/product-detail/product-detail.wxss */
page {
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.page {
  min-height: 100vh;
}

/* ========== 图片轮播 ========== */
.img-section {
  position: relative;
}

.img-swiper {
  width: 100%;
  height: 750rpx;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.img-counter {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* ========== 价格区域 ========== */
.price-section {
  background: #fff;
  padding: 24rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: #e54545;
  font-weight: 700;
}

.price-value {
  font-size: 52rpx;
  color: #e54545;
  font-weight: 800;
  line-height: 1;
}

.price-original {
  font-size: 26rpx;
  color: #ccc;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.price-discount {
  background: #fff0f0;
  color: #e54545;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1rpx solid #ffcccc;
  margin-left: 8rpx;
}

.price-info {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.sales-info, .stock-info {
  font-size: 22rpx;
  color: #999;
}

.tags-row {
  display: flex;
  gap: 8rpx;
}

.product-tag {
  font-size: 20rpx;
  color: #e54545;
  background: #fff5f5;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  border: 1rpx solid #ffcccc;
}

/* ========== 商品名称 ========== */
.name-section {
  background: #fff;
  padding: 0 24rpx 24rpx;
  margin-top: -8rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.5;
  display: block;
  margin-bottom: 8rpx;
}

.product-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* ========== 规格选择入口 ========== */
.spec-entry {
  display: flex;
  align-items: center;
  background: #fff;
  margin-top: 16rpx;
  padding: 24rpx;
}

.spec-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-right: 24rpx;
}

.spec-value {
  flex: 1;
  font-size: 26rpx;
  color: #999;
}

.spec-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* ========== 积分信息 ========== */
.points-info-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  margin-top: 2rpx;
  gap: 8rpx;
}

.points-icon {
  font-size: 28rpx;
}

.points-text {
  font-size: 24rpx;
  color: #666;
}

.points-earn {
  font-size: 22rpx;
  color: #ffd700;
  background: #fffbe6;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  margin-left: auto;
}

/* ========== 保障 ========== */
.guarantee-row {
  display: flex;
  justify-content: space-around;
  background: #fff;
  margin-top: 16rpx;
  padding: 24rpx 0;
}

.guarantee-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #666;
}

.guarantee-icon {
  color: #52c41a;
  font-weight: 700;
  font-size: 24rpx;
}

/* ========== 详情Tab ========== */
.detail-tabs {
  display: flex;
  background: #fff;
  margin-top: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.detail-tab.active {
  color: #e54545;
  font-weight: 700;
}

.detail-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #e54545;
  border-radius: 2rpx;
}

/* ========== 详情内容 ========== */
.detail-content {
  background: #fff;
}

.detail-card {
  padding: 24rpx;
}

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.detail-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
}

.detail-val {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.detail-desc-card {
  padding: 24rpx;
  border-top: 16rpx solid #f5f5f5;
}

.desc-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.desc-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

/* ========== 评价 ========== */
.reviews-content {
  background: #fff;
  padding: 24rpx;
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.review-avatar {
  font-size: 36rpx;
}

.review-user {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.review-stars {
  display: flex;
  gap: 2rpx;
}

.star {
  font-size: 22rpx;
  color: #ffd700;
}

.review-time {
  margin-left: auto;
  font-size: 22rpx;
  color: #999;
}

.review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.no-reviews {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.bar-icon-btn {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.bar-icon {
  font-size: 36rpx;
}

.bar-icon.favorited {
  color: #e54545;
}

.bar-icon-text {
  font-size: 18rpx;
  color: #666;
  margin-top: 2rpx;
}

.bar-cart-badge {
  position: absolute;
  top: -4rpx;
  right: 8rpx;
  background: #e54545;
  color: #fff;
  font-size: 16rpx;
  font-weight: 700;
  padding: 0 8rpx;
  border-radius: 16rpx;
  min-width: 28rpx;
  height: 24rpx;
  line-height: 24rpx;
  text-align: center;
}

.bar-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  margin-left: 12rpx;
}

.cart-btn {
  background: linear-gradient(135deg, #ff8c00, #ff6b00);
  color: #fff;
}

.buy-btn {
  background: linear-gradient(135deg, #c41e3a, #e54545);
  color: #fff;
}

.bar-btn:active {
  opacity: 0.85;
}

/* ========== 规格弹窗 ========== */
.spec-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.spec-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 201;
  max-height: 75vh;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}

.spec-popup-show {
  transform: translateY(0);
}

.spec-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.spec-product-info {
  display: flex;
  gap: 20rpx;
}

.spec-product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.spec-product-detail {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.spec-product-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #e54545;
}

.spec-product-stock {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.spec-product-selected {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
}

.spec-close {
  font-size: 40rpx;
  color: #999;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spec-list {
  padding: 24rpx 32rpx;
  max-height: 40vh;
}

.spec-group {
  margin-bottom: 24rpx;
}

.spec-group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-option {
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
}

.spec-option-active {
  background: #fff5f5;
  color: #e54545;
  border-color: #e54545;
  font-weight: 600;
}

.spec-qty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.qty-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.qty-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
  background: #fafafa;
}

.qty-input {
  width: 80rpx;
  height: 56rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.spec-confirm-btn {
  margin: 24rpx 32rpx;
  background: linear-gradient(135deg, #c41e3a, #e54545);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(196, 30, 58, 0.3);
}

.spec-confirm-btn:active {
  opacity: 0.85;
}
