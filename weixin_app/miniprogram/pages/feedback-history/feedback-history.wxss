/* pages/feedback-history/feedback-history.wxss */
.page-container {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 加载中 */
.loading-box {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.submit-btn {
  width: 280rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #e54545, #d63030);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

/* 列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 头部 */
.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.item-type {
  display: flex;
  align-items: center;
}

.type-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.type-text {
  font-size: 26rpx;
  color: #666;
}

.item-status {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-pending {
  background: #fff8e1;
  color: #f57c00;
}

.status-processing {
  background: #e3f2fd;
  color: #1976d2;
}

.status-resolved {
  background: #e8f5e9;
  color: #388e3c;
}

/* 内容 */
.item-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

/* 图片 */
.item-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.item-images image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

/* 时间 */
.item-time {
  font-size: 22rpx;
  color: #bbb;
}

/* 官方回复 */
.item-reply {
  margin-top: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f0f7ff, #e8f4fd);
  border-radius: 16rpx;
  border-left: 6rpx solid #1976d2;
}

.reply-header {
  margin-bottom: 12rpx;
}

.reply-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #1976d2;
  background: #fff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.reply-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.copy-btn {
  display: inline-block;
  font-size: 22rpx;
  color: #1976d2;
  margin-top: 16rpx;
}
