<!--pages/feedback-history/feedback-history.wxml-->
<view class="page-container">
  <!-- 加载中 -->
  <view class="loading-box" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{historyList.length === 0}}">
    <view class="empty-icon">📭</view>
    <view class="empty-title">暂无反馈记录</view>
    <view class="empty-desc">您提交的反馈将在这里显示</view>
    <button class="submit-btn" bindtap="goToFeedback">提交反馈</button>
  </view>

  <!-- 反馈列表 -->
  <view class="history-list" wx:else>
    <view class="history-item" wx:for="{{historyList}}" wx:key="_id">
      <!-- 头部 -->
      <view class="item-header">
        <view class="item-type">
          <image class="type-icon" src="{{item.type === 'bug' ? '/images/icons/bug.svg' : item.type === 'suggest' ? '/images/icons/suggest.svg' : item.type === 'complaint' ? '/images/icons/complaint.svg' : '/images/icons/other.svg'}}" mode="aspectFit"></image>
          <text class="type-text">{{item.typeText || '其他问题'}}</text>
        </view>
        <view class="item-status status-{{item.status}}">{{item.statusText}}</view>
      </view>

      <!-- 内容 -->
      <view class="item-content">{{item.content}}</view>

      <!-- 图片 -->
      <view class="item-images" wx:if="{{item.images.length > 0}}">
        <image 
          wx:for="{{item.images}}" 
          wx:for-item="img" 
          wx:for-index="imgIndex"
          wx:key="*this" 
          src="{{img}}" 
          mode="aspectFill"
          bindtap="previewImage"
          data-urls="{{item.images}}"
          data-current="{{img}}"
        ></image>
      </view>

      <!-- 时间 -->
      <view class="item-time">{{item.timeStr}}</view>

      <!-- 官方回复 -->
      <view class="item-reply" wx:if="{{item.reply}}">
        <view class="reply-header">
          <text class="reply-badge">官方回复</text>
        </view>
        <view class="reply-content">{{item.reply}}</view>
        <view class="copy-btn" bindtap="copyReply" data-text="{{item.reply}}">复制回复</view>
      </view>
    </view>
  </view>
</view>
