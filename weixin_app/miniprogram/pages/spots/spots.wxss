/**spots.wxss**/
page {
  background: #f5f5f5;
  min-height: 100vh;
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 顶部标题区 ========== */
.header-section {
  background: linear-gradient(135deg, #c41e3a, #e54545, #ff6b6b);
  padding: 40rpx 32rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.header-section::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.header-section::after {
  content: '';
  position: absolute;
  bottom: -40%;
  left: 10%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
}

.header-overlay {
  position: relative;
  z-index: 1;
}

.header-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.header-badge {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.header-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 2rpx;
}

/* ========== 搜索栏 ========== */
.search-bar-wrap {
  padding: 20rpx 24rpx 12rpx;
  background: linear-gradient(180deg, #e54545 0%, #f5f5f5 100%);
}

.search-bar-inner {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 36rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin-left: 12rpx;
  color: #333;
}

.search-placeholder {
  color: #bbb;
  font-size: 26rpx;
}

.search-clear {
  display: flex;
  align-items: center;
  margin-left: 8rpx;
}

/* ========== 分类筛选 ========== */
.filter-tabs {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-tab {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  transition: all 0.25s;
  flex-shrink: 0;
}

.filter-tab.active {
  background: linear-gradient(135deg, #c41e3a, #e54545);
  box-shadow: 0 4rpx 12rpx rgba(196, 30, 58, 0.3);
}

.filter-icon {
  font-size: 24rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.filter-tab.active .filter-label {
  color: #fff;
  font-weight: 600;
}

.filter-tab.active .filter-icon {
  filter: brightness(2);
}

/* ========== 地图区域 ========== */
.map-section {
  margin: 16rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.spot-map {
  width: 100%;
  height: 440rpx;
}

/* ========== 选中景点卡片 ========== */
.selected-card {
  display: flex;
  margin: 16rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  align-items: center;
  position: relative;
  overflow: hidden;
}

.selected-card:active {
  transform: scale(0.98);
  transition: transform 0.15s;
}

.card-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-icon-img {
  width: 72rpx;
  height: 72rpx;
}

.card-right {
  flex: 1;
  padding-left: 20rpx;
  min-width: 0;
}

.card-top-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #222;
}

.card-mbti {
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid;
}

.card-spot {
  display: block;
  font-size: 24rpx;
  color: #e54545;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.card-address-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.card-address-icon {
  font-size: 18rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.card-address {
  font-size: 20rpx;
  color: #888;
  line-height: 1.4;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.card-tag {
  font-size: 18rpx;
  color: #666;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.card-recommend {
  font-size: 20rpx;
  color: #888;
  display: block;
}

.card-arrow {
  flex-shrink: 0;
  padding-left: 12rpx;
}

.arrow-icon {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

/* ========== 景点列表 ========== */
.spot-list {
  margin: 20rpx 24rpx;
  padding-bottom: 40rpx;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.list-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.list-count {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.spot-item {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
  transition: transform 0.2s;
}

.spot-item:active {
  transform: scale(0.98);
}

.item-left {
  width: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-radius: 50%;
  margin: 20rpx;
  flex-shrink: 0;
  align-self: flex-start;
}

.item-icon-img {
  width: 68rpx;
  height: 68rpx;
}

.item-right {
  flex: 1;
  padding: 20rpx 20rpx 20rpx 0;
  min-width: 0;
}

.item-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.item-mbti {
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(229, 69, 69, 0.08);
}

.item-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.item-spot-name {
  display: block;
  font-size: 24rpx;
  color: #555;
  font-weight: 600;
  margin-top: 4rpx;
}

.item-address {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-recommend {
  display: block;
  font-size: 20rpx;
  color: #888;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.item-highlight {
  font-size: 18rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 500;
  border: 1rpx solid;
}

.item-locate {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  flex-shrink: 0;
  border-left: 1rpx solid #f0f0f0;
}

.locate-icon {
  font-size: 28rpx;
}

.locate-text {
  font-size: 18rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.empty-tip {
  font-size: 22rpx;
  color: #999;
}

/* ========== 详情弹窗 ========== */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.detail-popup {
  position: fixed;
  left: 0; right: 0; bottom: -100%;
  height: 82vh;
  z-index: 101;
  display: flex;
  flex-direction: column;
  border-radius: 36rpx 36rpx 0 0;
  overflow: hidden;
  transition: bottom 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.18);
}

.detail-popup.show {
  bottom: 0;
}

/* 弹窗头部 */
.detail-header {
  position: relative;
  padding: 40rpx 32rpx 36rpx;
  flex-shrink: 0;
}

.detail-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.detail-close text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 300;
}

.detail-header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.detail-icon-wrap {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}

.detail-icon-img {
  width: 100rpx;
  height: 100rpx;
}

.detail-name {
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.detail-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.detail-mbti {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
}

.detail-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
}

/* 弹窗内容区 */
.detail-body {
  flex: 1;
  height: 0;
  background: #f7f7f7;
  padding: 0 28rpx;
}

.detail-section {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
  position: relative;
  padding-left: 18rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #c41e3a, #e54545);
  border-radius: 3rpx;
}

.detail-info-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-info-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 14rpx;
}

.detail-info-label {
  font-size: 24rpx;
  color: #999;
  width: 70rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.detail-info-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  min-width: 0;
}

.detail-desc-box {
  background: #fff;
  border-radius: 14rpx;
  padding: 22rpx 20rpx;
}

.detail-full-desc {
  font-size: 26rpx;
  color: #555;
  line-height: 1.85;
}

.detail-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.highlight-pill {
  font-size: 23rpx;
  font-weight: 500;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid;
}

.detail-tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 14rpx;
  border-left: 5rpx solid;
}

.tip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #444;
  font-weight: 500;
}

.detail-recommend-box {
  border-radius: 14rpx;
  padding: 22rpx 20rpx;
}

.detail-recommend-text {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
}

/* 底部操作按钮 */
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 0 4rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 24rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.action-btn:active {
  transform: scale(0.96);
  transition: transform 0.15s;
}

.action-navigate {
  color: #fff;
}

.action-figure {
  background: #fff;
  color: #333;
  border: 1rpx solid #eee;
}

.action-icon {
  font-size: 32rpx;
}

.action-text {
  font-size: 28rpx;
  font-weight: 700;
}

.detail-bottom-space {
  height: 60rpx;
}
