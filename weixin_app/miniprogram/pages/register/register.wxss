/* pages/register/register.wxss */
page {
  background-color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 80rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-text {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  font-size: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 44rpx;
  font-weight: 500;
  color: #333;
}

.register-form {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.input-group {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  padding: 20rpx 0;
}

.input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.password-strength {
  display: flex;
  gap: 8rpx;
  align-items: center;
  margin-top: -20rpx;
}

.strength-bar-item {
  flex: 1;
  height: 8rpx;
  background-color: #e0e0e0;
  border-radius: 4rpx;
  transition: background-color 0.3s ease;
}

.strength-text {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
  width: 40rpx;
}

.register-btn {
  background-color: #e93b3d;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 40rpx;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(233, 59, 61, 0.3);
}

.extra-actions {
  margin-top: 30rpx;
}

.agreement {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.agree-checkbox {
  transform: scale(0.7);
}

.link {
  color: #576b95;
  font-size: 24rpx;
}

.footer {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 60rpx;
  font-size: 28rpx;
}

.footer-text {
  color: #999;
}

.footer .link {
  font-size: 28rpx;
  margin-left: 10rpx;
}
